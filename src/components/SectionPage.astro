---
import { getCollection, render } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	section: 'global' | 'us' | 'tech' | 'ai';
	name: string;
	emoji: string;
	blurb: string;
}
const { section, name, emoji, blurb } = Astro.props;

const entries = (await getCollection('briefing', (e) => e.data.section === section)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const rendered = await Promise.all(
	entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
const dateStr = (d: Date) => d.toISOString().slice(0, 10);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${name} | ${SITE_TITLE}`} description={blurb} />
		<style>
			main { width: 720px; max-width: calc(100% - 2em); margin: auto; padding: 2em 1em; }
			.date { color: rgb(var(--gray)); }
			article { margin-bottom: 2.5rem; border-bottom: 1px solid rgb(var(--gray-light)); padding-bottom: 1.5rem; }
			article h2 a { text-decoration: none; }
			.more { font-size: 0.92em; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{emoji} {name}</h1>
			<p>{blurb}</p>
			{rendered.map(({ entry, Content }) => (
				<article>
					<h2>
						<a href={`/briefing/${dateStr(entry.data.pubDate)}/#${section}`}>{entry.data.title}</a>
					</h2>
					<p class="date"><FormattedDate date={entry.data.pubDate} /></p>
					<Content />
					<p class="more">
						<a href={`/briefing/${dateStr(entry.data.pubDate)}/`}>→ 看这一天的整期简报</a>
					</p>
				</article>
			))}
		</main>
		<Footer />
	</body>
</html>
