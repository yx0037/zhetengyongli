---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 720px; max-width: calc(100% - 2em); margin: auto; padding: 2em 1em; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>关于本站</h1>
			<p>本站每天整理一期 X（Twitter）简报，包含四个栏目，每栏都可以单独看：</p>
			<ul>
				<li><a href="/global/"><strong>全球新闻</strong></a>：X 上热议的全球新闻，综合当日主流媒体头条整理。</li>
				<li><a href="/us/"><strong>美国新闻</strong></a>：X 上热议的美国新闻，综合当日主流媒体头条整理。</li>
				<li><a href="/tech/"><strong>科技</strong></a>：当日科技圈热议话题，编辑筛选。</li>
				<li><a href="/ai/"><strong>AI</strong></a>：当日 AI 圈热议话题，编辑筛选。</li>
			</ul>
			<p>
				每期简报按日期汇总在 <a href="/briefing/">每日简报</a> 里。全球与美国新闻综合 X 平台热议话题
				与当日主流媒体头条整理；科技与 AI 栏目为编辑筛选。所有栏目均逐条标注来源。
			</p>
		</main>
		<Footer />
	</body>
</html>
