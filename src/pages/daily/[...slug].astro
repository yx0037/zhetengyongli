---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
	const items = await getCollection('daily');
	return items.map((item) => ({ params: { slug: item.id }, props: item }));
}
type Props = CollectionEntry<'daily'>;
const item = Astro.props;
const { Content } = await render(item);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={item.data.title} description={item.data.description} />
		<style>
			main { width: 720px; max-width: calc(100% - 2em); margin: auto; padding: 2em 1em; }
			.tag { display: inline-block; font-size: 0.85em; border-radius: 999px; padding: 0.1rem 0.6rem; background: rgb(var(--gray-light)); }
			.date { color: rgb(var(--gray)); }
			.source { margin-top: 2rem; border-top: 1px solid rgb(var(--gray-light)); padding-top: 1rem; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p><a href="/daily/">← 返回每日资讯</a></p>
			<p><span class="tag">{item.data.category}</span></p>
			<h1>{item.data.title}</h1>
			<p class="date"><FormattedDate date={item.data.pubDate} /></p>
			<Content />
			{item.data.sourceUrl && (
				<p class="source">来源：<a href={item.data.sourceUrl} target="_blank" rel="noopener">{item.data.sourceName ?? item.data.sourceUrl}</a></p>
			)}
		</main>
		<Footer />
	</body>
</html>
