---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const SECTION_META = [
	{ key: 'global', name: '全球热榜', emoji: '🌍' },
	{ key: 'us', name: '美国热榜', emoji: '🇺🇸' },
	{ key: 'tech', name: '科技', emoji: '💻' },
	{ key: 'ai', name: 'AI', emoji: '🤖' },
] as const;

export async function getStaticPaths() {
	const all = await getCollection('briefing');
	const dates = [...new Set(all.map((e) => e.data.pubDate.toISOString().slice(0, 10)))];
	return dates.map((date) => ({ params: { date }, props: { date } }));
}

const { date } = Astro.props as { date: string };
const dayEntries = (await getCollection('briefing')).filter(
	(e) => e.data.pubDate.toISOString().slice(0, 10) === date,
);
const pubDate = dayEntries[0].data.pubDate;
const title =
	dayEntries.find((e) => e.data.issueTitle)?.data.issueTitle ?? `X 每日简报 · ${date}`;
const description =
	dayEntries.find((e) => e.data.issueDescription)?.data.issueDescription ??
	dayEntries.map((e) => e.data.description).join(' ');
const sections = await Promise.all(
	SECTION_META.map(async (meta) => {
		const entry = dayEntries.find((e) => e.data.section === meta.key);
		if (!entry) return null;
		const { Content } = await render(entry);
		return { ...meta, Content };
	}),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main { width: 720px; max-width: calc(100% - 2em); margin: auto; padding: 2em 1em; }
			.date { color: rgb(var(--gray)); }
			section { margin-bottom: 2.5rem; }
			.src { margin-top: 2rem; border-top: 1px solid rgb(var(--gray-light)); padding-top: 1rem; font-size: 0.92em; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p><a href="/briefing/">← 返回每日简报</a></p>
			<h1>{title}</h1>
			<p class="date"><FormattedDate date={pubDate} /></p>
			<p>
				本期简报四栏各 10 条。热榜名次为当日下午（北京时间）抓取的 X 趋势快照；
				科技与 AI 两栏为编辑筛选，以当日动态为主，少数本月大事会标明日期。
				也可以按栏目看：<a href="/global/">全球热榜</a> · <a href="/us/">美国热榜</a> ·
				<a href="/tech/">科技</a> · <a href="/ai/">AI</a>。
			</p>
			{sections.map((s) => s && (
				<section id={s.key}>
					<h2>{s.emoji} {s.name}</h2>
					<s.Content />
				</section>
			))}
			<p class="src">
				<strong>数据来源</strong>：全球 / 美国热榜来自 X 公开趋势数据（经 trends.cyberkendra.com 整理，约每 30 分钟更新）；
				科技与 AI 栏目为编辑筛选，来源已逐条标注。
			</p>
		</main>
		<Footer />
	</body>
</html>
