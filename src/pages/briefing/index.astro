---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const all = await getCollection('briefing');
const byDate = new Map<string, typeof all>();
for (const e of all) {
	const d = e.data.pubDate.toISOString().slice(0, 10);
	if (!byDate.has(d)) byDate.set(d, []);
	byDate.get(d)!.push(e);
}
const issues = [...byDate.entries()]
	.sort((a, b) => b[0].localeCompare(a[0]))
	.map(([date, entries]) => ({
		date,
		pubDate: entries[0].data.pubDate,
		title: entries.find((e) => e.data.issueTitle)?.data.issueTitle ?? `X 每日简报 · ${date}`,
		description:
			entries.find((e) => e.data.issueDescription)?.data.issueDescription ??
			entries.map((e) => e.data.description).join(' '),
	}));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`每日简报 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 960px; max-width: calc(100% - 2em); margin: auto; padding: 2em 1em; }
			ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.25rem; }
			li { border: 1px solid rgb(var(--gray-light)); border-radius: 12px; padding: 1rem 1.25rem; }
			li a { text-decoration: none; }
			.date { color: rgb(var(--gray)); margin: 0.25rem 0; }
			.desc { margin: 0.5rem 0 0; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>每日简报</h1>
			<p>
				每天一期，四栏各 10 条。也可以按栏目看：
				<a href="/global/">🌍 全球热榜</a> · <a href="/us/">🇺🇸 美国热榜</a> ·
				<a href="/tech/">💻 科技</a> · <a href="/ai/">🤖 AI</a>
			</p>
			<ul>
				{issues.map((item) => (
					<li>
						<a href={`/briefing/${item.date}/`}>
							<strong>{item.title}</strong>
							<p class="date"><FormattedDate date={item.pubDate} /></p>
							<p class="desc">{item.description}</p>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
