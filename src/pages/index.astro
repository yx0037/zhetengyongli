---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const SECTIONS = [
	{ key: 'global', name: '全球新闻', emoji: '🌍', href: '/global/', blurb: 'X 上热议的全球新闻 10 条，逐条标注来源。' },
	{ key: 'us', name: '美国新闻', emoji: '🇺🇸', href: '/us/', blurb: 'X 上热议的美国新闻 10 条，逐条标注来源。' },
	{ key: 'tech', name: '科技', emoji: '💻', href: '/tech/', blurb: '当日科技圈热议话题 10 条。' },
	{ key: 'ai', name: 'AI', emoji: '🤖', href: '/ai/', blurb: '当日 AI 圈热议话题 10 条。' },
] as const;

const all = await getCollection('briefing');
const latest = SECTIONS.map((s) => ({
	...s,
	entry: all
		.filter((e) => e.data.section === s.key)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0],
}));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main { width: 960px; max-width: calc(100% - 2em); margin: auto; padding: 2em 1em; }
			.cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 1.5rem 0 2.5rem; }
			@media (max-width: 720px) { .cols { grid-template-columns: 1fr 1fr; } }
			.col { display: block; border: 1px solid rgb(var(--gray-light)); border-radius: 12px; padding: 0.9rem 1.1rem; text-decoration: none; color: inherit; }
			.col:hover { border-color: var(--accent); }
			.col h3 { margin: 0 0 0.4rem; }
			.col p { margin: 0; font-size: 0.92em; }
			ul.list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.25rem; }
			ul.list li { border: 1px solid rgb(var(--gray-light)); border-radius: 12px; padding: 1rem 1.25rem; }
			ul.list li a { text-decoration: none; }
			.tag { display: inline-block; font-size: 0.85em; border-radius: 999px; padding: 0.1rem 0.6rem; background: rgb(var(--gray-light)); margin-right: 0.5rem; }
			.date { color: rgb(var(--gray)); margin: 0.25rem 0; }
			.desc { margin: 0.5rem 0 0; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>X 每日简报</h1>
			<p>{SITE_DESCRIPTION}</p>
			<div class="cols">
				{SECTIONS.map((s) => (
					<a class="col" href={s.href}>
						<h3>{s.emoji} {s.name}</h3>
						<p>{s.blurb}点击查看全部 →</p>
					</a>
				))}
			</div>
			<h2>最新内容</h2>
			<ul class="list">
				{latest.map((s) => s.entry && (
					<li>
						<a href={s.href}>
							<span class="tag">{s.emoji} {s.name}</span>
							<strong>{s.entry.data.title}</strong>
							<p class="date"><FormattedDate date={s.entry.data.pubDate} /></p>
							<p class="desc">{s.entry.data.description}</p>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
