---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const daily = (await getCollection('daily')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const cases = (await getCollection('cases')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main { width: 960px; max-width: calc(100% - 2em); margin: auto; padding: 2em 1em; }
			.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.5rem; }
			@media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
			.card { border: 1px solid rgb(var(--gray-light)); border-radius: 12px; padding: 1rem 1.25rem; }
			.card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
			.card li a { text-decoration: none; }
			.tag { display: inline-block; font-size: 0.85em; border-radius: 999px; padding: 0.1rem 0.6rem; background: rgb(var(--gray-light)); margin-right: 0.5rem; }
			.date { color: rgb(var(--gray)); margin: 0.2rem 0; font-size: 0.9em; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>折腾用例库</h1>
			<p>{SITE_DESCRIPTION}</p>
			<p><a href="/cases/">进入用例库 →</a> &nbsp; <a href="/daily/">进入每日资讯 →</a></p>
			<div class="grid">
				<section class="card">
					<h2>最新用例</h2>
					{ cases.length === 0 ? <p>用例库还在整理中，第一批即将发布。</p> : <ul>{cases.map((c) => (<li><a href={`/cases/${c.id}/`}><span class="tag">{c.data.category}</span><strong>{c.data.title}</strong><p class="date"><FormattedDate date={c.data.pubDate} /></p></a></li>))}</ul> }
				</section>
				<section class="card">
					<h2>今日资讯</h2>
					<ul>{daily.map((d) => (<li><a href={`/daily/${d.id}/`}><span class="tag">{d.data.category}</span><strong>{d.data.title}</strong><p class="date"><FormattedDate date={d.data.pubDate} /></p></a></li>))}</ul>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
