---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const all = await getCollection('briefing');
const byDate = new Map<string, typeof all>();
for (const e of all) {
	const d = e.data.pubDate.toISOString().slice(0, 10);
	if (!byDate.has(d)) byDate.set(d, []);
	byDate.get(d)!.push(e);
}
const issues = [...byDate.entries()]
	.sort((a, b) => b[0].localeCompare(a[0]))
	.slice(0, 7)
	.map(([date, entries]) => ({
		date,
		pubDate: entries[0].data.pubDate,
		title: entries.find((e) => e.data.issueTitle)?.data.issueTitle ?? `X 每日简报 · ${date}`,
		description:
			entries.find((e) => e.data.issueDescription)?.data.issueDescription ??
			entries.map((e) => e.data.description).join(' '),
	}));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main { width: 960px; max-width: calc(100% - 2em); margin: auto; padding: 2em 1em; }
			.cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 1.5rem 0 2.5rem; }
			@media (max-width: 720px) { .cols { grid-template-columns: 1fr 1fr; } }
			.col { display: block; border: 1px solid rgb(var(--gray-light)); border-radius: 12px; padding: 0.9rem 1.1rem; text-decoration: none; color: inherit; }
			.col:hover { border-color: var(--accent); }
			.col h3 { margin: 0 0 0.4rem; }
			.col p { margin: 0; font-size: 0.92em; }
			ul.list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.25rem; }
			ul.list li { border: 1px solid rgb(var(--gray-light)); border-radius: 12px; padding: 1rem 1.25rem; }
			ul.list li a { text-decoration: none; }
			.date { color: rgb(var(--gray)); margin: 0.25rem 0; }
			.desc { margin: 0.5rem 0 0; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>X 每日简报</h1>
			<p>{SITE_DESCRIPTION}</p>
			<div class="cols">
				<a class="col" href="/global/"><h3>🌍 全球热榜</h3><p>X 全球趋势 Top 10，附中文背景注。点击查看全部 →</p></a>
				<a class="col" href="/us/"><h3>🇺🇸 美国热榜</h3><p>X 美国趋势 Top 10，附中文背景注。点击查看全部 →</p></a>
				<a class="col" href="/tech/"><h3>💻 科技</h3><p>当日科技圈热议话题 10 条。点击查看全部 →</p></a>
				<a class="col" href="/ai/"><h3>🤖 AI</h3><p>当日 AI 圈热议话题 10 条。点击查看全部 →</p></a>
			</div>
			<h2>最新简报</h2>
			<ul class="list">
				{issues.map((item) => (
					<li>
						<a href={`/briefing/${item.date}/`}>
							<strong>{item.title}</strong>
							<p class="date"><FormattedDate date={item.pubDate} /></p>
							<p class="desc">{item.description}</p>
						</a>
					</li>
				))}
			</ul>
			<p style="margin-top:2rem"><a href="/briefing/">查看全部简报 →</a></p>
		</main>
		<Footer />
	</body>
</html>
