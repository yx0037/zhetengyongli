---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const items = (await getCollection('cases')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`用例库 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 960px; max-width: calc(100% - 2em); margin: auto; padding: 2em 1em; }
			ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.25rem; }
			li { border: 1px solid rgb(var(--gray-light)); border-radius: 12px; padding: 1rem 1.25rem; }
			li a { text-decoration: none; }
			.tag { display: inline-block; font-size: 0.85em; border-radius: 999px; padding: 0.1rem 0.6rem; background: rgb(var(--gray-light)); margin-right: 0.5rem; }
			.date { color: rgb(var(--gray)); margin: 0.25rem 0; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>用例库</h1>
			<p>NAS + 电脑/网络 + 智能家居，每个用例都是实测过的，附可复制的提示词。每日短资讯在 <a href="/daily/">每日资讯</a>。</p>
			{items.length === 0 ? (
				<p>用例库还在整理中，第一批用例即将发布。先看看 <a href="/daily/">每日资讯</a> 的示例。</p>
			) : (
				<ul>
					{items.map((item) => (
						<li>
							<a href={`/cases/${item.id}/`}>
								<span class="tag">{item.data.category}</span>
								<strong>{item.data.title}</strong>
								<p class="date"><FormattedDate date={item.data.pubDate} /></p>
								<p>{item.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>
